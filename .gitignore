__pycache__/
*.pyc

# Artefak runtime — generated, jangan pernah di-commit.
backups/
reports/
logs/
farm.log

# Artefak launcher (dibuat manual, bukan dari repo).
*.lnk

# Vendor .pylibs DI-COMMIT dengan sengaja: repo harus jalan tanpa pip install
# dan tanpa bergantung pada user-site Python mesin mana pun.
.pylibs/**/__pycache__/
.pylibs/**/*.pyc
